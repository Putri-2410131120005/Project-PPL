APP_NAME=SMART-ABK
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-DOMAIN.example

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Isi dengan nilai database yang dibuat melalui VistaPanel InfinityFree.
DB_CONNECTION=mysql
DB_HOST=YOUR_INFINITYFREE_DB_HOST
DB_PORT=3306
DB_DATABASE=YOUR_INFINITYFREE_DB_NAME
DB_USERNAME=YOUR_INFINITYFREE_DB_USER
DB_PASSWORD=YOUR_INFINITYFREE_DB_PASSWORD
DB_SUPPORTS_TRIGGERS=false

# File-based storage tidak membutuhkan tabel session/cache tambahan.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=smart_abk_session
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
PROTECTED_STUDENT_PHOTOS=true

# InfinityFree tidak menyediakan queue worker permanen; proses notifikasi
# dikerjakan selama request agar job tidak menumpuk di tabel jobs.
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
WEB_PUSH_TIMEOUT=10

VAPID_SUBJECT=mailto:admin@YOUR-DOMAIN.example
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="admin@YOUR-DOMAIN.example"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Jangan menyimpan password di file ini. Akun awal akan disiapkan melalui
# prosedur administratif terpisah setelah database production tersedia.
SUPER_ADMIN_NAME=
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_EMAIL=
